"support.faq.title" = "अक्सर पूछे जाने वाले प्रश्न";
"support.faq.q1" = "क्या Super X चैनल या सदस्यता देता है?";
"support.faq.a1" = "नहीं। Super X केवल एक प्लेयर है और इसके साथ कोई चैनल, प्लेलिस्ट या सदस्यता नहीं आती। आप अपने प्रदाता से मिली प्लेलिस्ट या Xtream खाता जोड़ते हैं, और Super X उसे आपके लिए चलाता है।";
"support.faq.q2" = "मेरा डेटा कहाँ सहेजा जाता है?";
"support.faq.a2" = "सब कुछ इसी डिवाइस पर रहता है: आपकी प्लेलिस्ट, पसंदीदा, देखने का इतिहास, डाउनलोड और सेटिंग्स ऐप में स्थानीय रूप से सहेजे जाते हैं। Super X के कोई सर्वर नहीं हैं और आपकी देखने की जानकारी न अपलोड होती है, न ट्रैक।";
"support.faq.q3" = "कोई चैनल या फ़िल्म नहीं चल रही। मैं क्या जाँचूँ?";
"support.faq.a3" = "ज़्यादातर प्लेबैक समस्याएँ प्रदाता की ओर से होती हैं: सदस्यता समाप्त, आपके खाते की कनेक्शन सीमा पूरी, या प्रदाता का सर्वर बंद। सदस्यता पेज पर समाप्ति तारीख देखें और सेटिंग्स में कनेक्शन परीक्षण चलाकर साफ़ भाषा में परिणाम देखें।";
"support.faq.q4" = "अभिभावकीय PIN क्या सुरक्षित रखता है?";
"support.faq.a4" = "PIN वयस्क-सामग्री फ़िल्टर बंद करने, ऐप का सारा डेटा मिटाने, सेटिंग्स लॉक चालू होने पर सेटिंग्स खोलने, और लॉक की गई श्रेणियों में आपके द्वारा लॉक की गई किसी भी श्रेणी को सुरक्षित रखता है। लॉक श्रेणी PIN डाले बिना नहीं खुल सकती। PIN केवल इस डिवाइस के Keychain में सहेजा जाता है और कभी बैकअप में शामिल नहीं होता।";
"support.faq.q5" = "मैं अपना सेटअप नए डिवाइस पर कैसे ले जाऊँ?";
"support.faq.a5" = "सेटिंग्स में, बैकअप का उपयोग करके अपनी सेटिंग्स, प्लेलिस्ट, पसंदीदा और बाद में देखें सूची को एक फ़ाइल में निर्यात करें, फिर उस फ़ाइल को नए डिवाइस पर आयात करें। सुरक्षा के लिए, सेटिंग्स निर्यात में प्लेलिस्ट पासवर्ड शामिल नहीं होते — आयात के दौरान आपको वे फिर से डालने होंगे। पासवर्ड सहित एक अलग पूर्ण बैकअप भी मौजूद है, और ऐप उसे बनाने से पहले आपको साफ़ चेतावनी देता है।";
"support.faq.q6" = "मेरी सदस्यता समाप्त क्यों दिखती है?";
"support.faq.a6" = "समाप्ति की तारीख और समय आपके अपने प्रदाता के पैनल से आते हैं — वही जवाब जो प्रदाता ऐप के साइन इन करने पर देता है। वह समय बीत जाने पर प्रदाता स्ट्रीम रोक देता है, और Super X सदस्यता को समाप्त दिखाकर प्लेबैक रोक देता है। अपने प्रदाता से नवीनीकरण करने पर, अगली बार जब ऐप खाते की जाँच करेगा तो तारीख अपडेट हो जाएगी।";
