"support.title" = "Destek";
"support.faq.title" = "Sık Sorulan Sorular";
"support.faq.q1" = "Super X kanal veya abonelik sağlıyor mu?";
"support.faq.a1" = "Hayır. Super X yalnızca bir oynatıcıdır; kanal, oynatma listesi veya abonelik içermez. Kendi sağlayıcınızdan aldığınız listeyi ya da Xtream hesabını eklersiniz, Super X de onu sizin için oynatır.";
"support.faq.q2" = "Verilerim nerede saklanıyor?";
"support.faq.a2" = "Her şey bu cihazda kalır: listeleriniz, favorileriniz, izleme geçmişiniz, indirilenler ve ayarlarınız uygulamada yerel olarak saklanır. Super X'in sunucusu yoktur ve izledikleriniz hakkında hiçbir şey yüklenmez veya izlenmez.";
"support.faq.q3" = "Bir kanal veya film oynamıyor. Neyi kontrol etmeliyim?";
"support.faq.a3" = "Oynatma sorunlarının çoğu sağlayıcı kaynaklıdır: süresi dolmuş bir abonelik, hesabınızın bağlantı sınırına ulaşılması veya sağlayıcının sunucusunun kapalı olması. Abonelikler sayfasından bitiş tarihini kontrol edin ve Ayarlar'daki Bağlantıyı Test Et'i çalıştırıp sonucu sade bir dille görün.";
"support.faq.q4" = "Ebeveyn PIN'i neyi koruyor?";
"support.faq.a4" = "PIN; yetişkin içerik filtresini kapatmayı, tüm uygulama verilerini silmeyi, ayarlar kilidi açıkken Ayarlar'ı açmayı ve Kilitli Kategoriler altında kilitlediğiniz kategorileri korur. Kilitli bir kategori, PIN girilmeden açılamaz. PIN yalnızca bu cihazın Anahtar Zinciri'nde saklanır ve hiçbir yedeğe dahil edilmez.";
"support.faq.q5" = "Kurulumumu yeni bir cihaza nasıl taşırım?";
"support.faq.a5" = "Ayarlar'da Yedekleme'yi kullanarak ayarlarınızı, listelerinizi, favorilerinizi ve Daha Sonra İzle listenizi bir dosyaya aktarın, ardından o dosyayı yeni cihazda içe aktarın. Güvenlik için ayar dışa aktarımı liste parolalarını içermez — içe aktarırken onları yeniden girmeniz istenir. Parolaları içeren ayrı bir tam yedek de vardır ve uygulama onu oluşturmadan önce sizi açıkça uyarır.";
"support.faq.q6" = "Aboneliğim neden süresi dolmuş görünüyor?";
"support.faq.a6" = "Bitiş tarihi ve saati, kendi sağlayıcınızın panelinden gelir — uygulama oturum açtığında sağlayıcının verdiği yanıtın aynısıdır. O an geçtiğinde sağlayıcı yayınları durdurur; Super X de aboneliği süresi dolmuş olarak gösterir ve oynatmayı engeller. Sağlayıcınızdan yenileme yapmak, uygulama hesabı bir sonraki kez doğruladığında tarihi günceller.";
